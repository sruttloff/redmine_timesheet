<div class="autoscroll">
<table class="list time-entries">
  <thead><tr>
    <th class="checkbox hide-when-print"><%= check_box_tag 'check_all', '', false, class: 'timesheet-check-all', id: nil, title: l(:button_check_all), 'aria-label' => l(:button_check_all) %></th>
    <th><%= l(:label_date) %></th>
    <th><%= l(:label_member) %></th>
    <th><%= l(:label_activity) %></th>
    <th><%= l(:label_project) %></th>
    <th><%= l(:label_version) %></th>
    <th><%= l(:label_issue) %></th>
    <th><%= l(:field_comments) %></th>
    <th><%= l(:field_hours) %></th>
    <%= call_hook(:plugin_timesheet_views_timesheet_group_header, {}) %>
    <th class="buttons hide-when-print"></th>
  </tr></thead>
  <tbody><%= render partial: 'time_entry', collection: entry[:logs], locals: {time_entries: entry[:logs]} %></tbody>
</table>
</div>
