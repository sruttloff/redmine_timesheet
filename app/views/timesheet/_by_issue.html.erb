<% entry[:issues].each_with_index do |(issue, logs), issue_index| %>
  <% toggle_id = "issue-#{group_index}-#{issue_index}" %>
  <h4>
    <%= toggle_issue_arrows(toggle_id) %>
    <%= issue ? link_to_issue(issue) : l(:timesheet_without_visible_issue) %>
    (<%= number_with_precision(logs.sum(&:hours), precision: @precision) %> <%= l(:field_hours) %>)
  </h4>
  <div data-timesheet-details="<%= toggle_id %>" hidden>
    <%= render partial: 'timesheet_group', locals: {entry: {logs: logs}, name: issue, total: logs.sum(&:hours)} %>
  </div>
  <%= call_hook(:plugin_timesheet_views_timesheet_time_entry_sum, issue: issue, time_entries: logs, precision: @precision) %>
<% end %>
