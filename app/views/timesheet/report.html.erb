<div class="contextual">
  <%= link_to_csv_export(@timesheet) %>
  <%= link_to_iif_export(@timesheet) %>
  <%= permalink_to_timesheet(@timesheet) %>
</div>
<h2><%= l(:timesheet_title) %></h2>
<%= render partial: 'form' %>
<%= call_hook(:plugin_timesheet_views_timesheets_report_before_time_entries, timesheet: @timesheet) %>
<%= form_tag({}, id: 'time_entries', data: {cm_url: url_for(controller: 'timesheet', action: 'context_menu')}) do %>
  <% if @timesheet.entries.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
    <h2><%= l(:label_spent_time) %> (<%= number_with_precision(@grand_total, precision: @precision) %> <%= l(:field_hours) %>)</h2>
    <% @timesheet.time_entries.each_with_index do |(name, entry), index| %>
      <section class="group">
        <h3>
          <% if @timesheet.sort == :date %><%= toggle_issue_arrows("date-#{index}") %><% end %>
          <%= name %> (<%= number_with_precision(@total[name], precision: @precision) %> <%= l(:field_hours) %>)
          <% if @timesheet.sort == :project %><%= showing_users(entry[:users]) %><% end %>
        </h3>
        <% if @timesheet.sort == :issue %>
          <%= render partial: 'by_issue', locals: {entry: entry, name: name, total: @total[name], group_index: index} %>
        <% else %>
          <div <%= "data-timesheet-details=date-#{index} hidden" if @timesheet.sort == :date %>>
            <%= render partial: 'timesheet_group', locals: {entry: entry, name: name, total: @total[name]} %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% end %>
<% end %>
<% content_for(:header_tags) do %>
  <%= stylesheet_link_tag 'timesheet.css', plugin: 'redmine_timesheet' %>
  <%= stylesheet_link_tag 'timesheet-print.css', plugin: 'redmine_timesheet', media: 'print' %>
  <%= javascript_include_tag 'timesheet.js', plugin: 'redmine_timesheet' %>
  <%= call_hook(:plugin_timesheet_views_timesheets_report_header_tags, timesheet: @timesheet) %>
<% end %>
<%= context_menu %>
<%= call_hook(:plugin_timesheet_view_timesheets_report_bottom, timesheet: @timesheet) %>
<%= call_hook(:plugin_timesheet_views_timesheets_report_bottom, timesheet: @timesheet) %>
