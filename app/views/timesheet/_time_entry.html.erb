<% if add_week_number?(time_entries, time_entry_counter) %>
  <tr class="week-number"><td class="hide-when-print"></td><td colspan="7"></td><td class="hours"><%= time_entry_title(time_entry) %></td><td class="hide-when-print"></td></tr>
<% end %>
<% issue = @timesheet.visible_issue(time_entry) %>
<tr class="time_entry <%= cycle('odd', 'even') %> hascontextmenu <%= call_hook(:plugin_timesheet_view_timesheets_time_entry_row_class, time_entry: time_entry) %> <%= call_hook(:plugin_timesheet_views_timesheets_time_entry_row_class, time_entry: time_entry) %>" data-id="<%= time_entry.id %>" title="<%= time_entry_title(time_entry) %>">
  <td class="checkbox hide-when-print"><%= check_box_tag 'ids[]', time_entry.id, false, class: 'checkbox', id: nil %></td>
  <td><%= format_date(time_entry.spent_on) %></td>
  <td><%= time_entry.user.name %></td>
  <td><%= time_entry.activity.name %></td>
  <td><%= time_entry.project.name %></td>
  <td><%= issue&.fixed_version %></td>
  <td><%= link_to_issue(issue) if issue %></td>
  <td><%= time_entry.comments %></td>
  <td class="hours"><strong><%= number_with_precision(time_entry.hours, precision: @precision) %></strong></td>
  <%= call_hook(:plugin_timesheet_views_timesheet_time_entry, time_entry: time_entry, precision: @precision) %>
  <td class="buttons hide-when-print">
    <% if time_entry.editable_by?(User.current) %>
      <%= link_to sprite_icon('edit'), edit_time_entry_path(time_entry), title: l(:button_edit), 'aria-label' => l(:button_edit), class: 'icon-only icon-edit' %>
      <%= link_to sprite_icon('del'), time_entry_path(time_entry), method: :delete, data: {confirm: l(:text_are_you_sure)}, title: l(:button_delete), 'aria-label' => l(:button_delete), class: 'icon-only icon-del' %>
    <% end %>
  </td>
</tr>
<% if add_day_total?(time_entries, time_entry_counter) %>
  <tr class="total"><td class="hide-when-print"></td><td colspan="7"></td><td class="hours"><%= calculate_day_total(time_entries, time_entry_counter) %></td><td class="hide-when-print"></td></tr>
<% end %>
