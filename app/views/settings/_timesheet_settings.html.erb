<p><label for="settings_list_size"><%= l(:timesheet_list_size) %></label>
<%= number_field_tag 'settings[list_size]', @settings['list_size'], min: 2, max: 30 %></p>
<p><label for="settings_precision"><%= l(:timesheet_precision) %></label>
<%= number_field_tag 'settings[precision]', @settings['precision'], min: 0, max: 10 %></p>
<p><label for="settings_project_status"><%= l(:timesheet_project_status) %></label>
<%= select_tag 'settings[project_status]', options_for_select([[l(:timesheet_active_projects), 'active'], [l(:timesheet_all_projects), 'all']], @settings['project_status']) %></p>
<p><label for="settings_user_status"><%= l(:timesheet_user_status) %></label>
<%= select_tag 'settings[user_status]', options_for_select([[l(:timesheet_active_users), 'active'], [l(:timesheet_all_users), 'all']], @settings['user_status']) %></p>
<p><label for="settings_invoice_rate_field_id"><%= l(:timesheet_invoice_rate_field) %></label>
<%= select_tag 'settings[invoice_rate_field_id]', options_from_collection_for_select(ProjectCustomField.where(field_format: ['float', 'int']).order(:name), :id, :name, @settings['invoice_rate_field_id']), include_blank: true %>
<em class="info"><%= l(:timesheet_invoice_rate_hint) %></em></p>
